TYPESAFE_API_KEY=

# SQLite evaluation archive. Defaults to ./data/analytics.sqlite.
# Use an absolute path on a persistent disk in production.
# ANALYTICS_DB_PATH=/var/lib/killmyidea/analytics.sqlite

# Absolute base URL for OG/Twitter image tags. Defaults to https://killmyidea.biz.
# SITE_URL=

# DataFast cookieless analytics. Production builds default to the site's id
# (see vite.config.ts); set an id here to also track in dev, or "off" to disable.
# DATAFAST_WEBSITE_ID=dfid_xxx
# DATAFAST_DOMAIN=killmyidea.biz
# Extra hostnames counted under the same site (comma-separated); empty to disable.
# DATAFAST_ALLOWED_HOSTNAMES=killmyidea.stemonte.io

# Local UI development only: returns fixture answers instead of calling Jev.
# Ignored in production.
# TYPESAFE_MOCK=1
